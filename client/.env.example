# ────────────────────────────────────────────────
# RentCheck Client — Environment Variables
# Copy this file to client/.env and fill in values.
# NEVER commit client/.env — it's listed in .gitignore.
# ────────────────────────────────────────────────

# Supabase project URL (find in: Supabase Dashboard → Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable/anon key (find in: Supabase Dashboard → Settings → API → anon/public)
# This key is safe to expose in the browser — it enforces Row Level Security (RLS).
VITE_SUPABASE_ANON_KEY=your-anon-key
